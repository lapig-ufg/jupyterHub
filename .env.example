# ──────────────────────────────────────────────────────────────────
# LAPIG JupyterHub — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env preenchido — ele contém credenciais sensíveis.
# ──────────────────────────────────────────────────────────────────

# ── Rede interna do Hub ───────────────────────────────────────────
# Endereço e porta onde o JupyterHub escuta internamente.
# O Traefik faz o HTTPS na frente — mantenha http:// aqui.
JUPYTERHUB_BIND_URL=http://0.0.0.0:443

# ── OAuth2 / Keycloak ─────────────────────────────────────────────
# Client ID cadastrado no realm do Keycloak.
OAUTH_CLIENT_ID=<client-id>

# Client Secret gerado pelo Keycloak (aba Credentials do client).
# Rotacione no Keycloak se este valor vazar.
OAUTH_CLIENT_SECRET=<client-secret>

# URL de callback do Hub — deve bater EXATAMENTE com o cadastrado
# no Keycloak em "Valid redirect URIs". Use https://.
OAUTH_CALLBACK_URL=https://<dominio-do-hub>/hub/oauth_callback

# URLs do realm Keycloak — substitua <keycloak-host> e <realm>.
# Use https:// em produção.
OAUTH_AUTHORIZE_URL=https://<keycloak-host>/realms/<realm>/protocol/openid-connect/auth
OAUTH_TOKEN_URL=https://<keycloak-host>/realms/<realm>/protocol/openid-connect/token

# ── Criptografia do auth_state ────────────────────────────────────
# Chave obrigatória para o JupyterHub criptografar os tokens OAuth
# em repouso. Gere com: openssl rand -hex 32
# Se perder esta chave, usuários só precisam reautenticar.
JUPYTERHUB_CRYPT_KEY=<64-caracteres-hex>

# ── Infraestrutura Docker ─────────────────────────────────────────
# Nome da rede Docker overlay que conecta Hub, Traefik e containers
# de usuário. Deve ser overlay (não bridge) para Swarm.
DOCKER_NETWORK_NAME=<nome-da-rede-overlay>

# ── Timeouts do Spawner ───────────────────────────────────────────
# Tempo máximo (segundos) para o container do usuário iniciar.
# Aumente se a imagem for grande ou o servidor lento.
SPAWNER_START_TIMEOUT=300
SPAWNER_HTTP_TIMEOUT=300

# ── Monitoramento (health-check) ──────────────────────────────────
# Intervalo em segundos entre cada coleta de métricas.
MONITOR_INTERVAL=60

# Percentual de RAM acima do qual um WARNING é registrado no error.log.
MEM_WARN_PERCENT=90